---
import BaseLayout from '../layouts/BaseLayout.astro';
import Album from '../components/Album.astro';
import { path, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [line1, line2] = t('home.hero.title').split('\n');
---

<BaseLayout lang={lang} route="home">
  <h1 class="sr-only">Rizk — {t('site.tagline')}</h1>

  <Album lang={lang} />

  <!-- Intro -->
  <section class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-36">
    <div class="flex items-start gap-6 md:col-span-3">
      <span class="label text-piedra">—</span>
      <span class="label">Rizk</span>
    </div>
    <div class="md:col-span-8 md:col-start-5">
      <p class="text-4xl leading-[1.05] font-light tracking-[-0.03em] md:text-6xl">
        {line1}<br />{line2}
      </p>
      <p class="mt-10 max-w-2xl text-xl leading-snug font-light text-carbon/75 md:text-2xl">{t('home.intro')}</p>
      <div class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
        <a href={path('walkthroughs', lang)} class="label link-underline py-1">{t('home.cta.walkthroughs')} →</a>
        <a href={path('contact', lang)} class="label link-underline py-1 text-oliva">{t('home.cta.contact')} →</a>
      </div>
    </div>
  </section>
</BaseLayout>
