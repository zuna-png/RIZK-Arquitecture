---
// Cabecera editorial de sección: "01.  PROYECTOS" + título + intro.
interface Props {
  number: string;
  label: string;
  title: string;
  intro?: string;
}
const { number, label, title, intro } = Astro.props;
---

<section class="wrap pt-16 pb-12 md:pt-28 md:pb-20">
  <div class="flex items-center gap-6 border-b border-carbon/15 pb-4">
    <span class="label text-piedra">{number}.</span>
    <span class="label">{label}</span>
  </div>
  <div class="mt-10 grid gap-8 md:mt-16 md:grid-cols-12">
    <h1 class="text-5xl font-light tracking-[-0.03em] md:col-span-7 md:text-7xl lg:text-8xl">{title}</h1>
    {intro && <p class="max-w-md text-lg leading-relaxed text-carbon/70 md:col-span-4 md:col-start-9 md:self-end">{intro}</p>}
  </div>
</section>
