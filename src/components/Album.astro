---
/**
 * Álbum de proyectos a pantalla completa (página de inicio).
 * - Crossfade automático cada AUTOPLAY_MS, con barra de progreso y botón de pausa.
 * - Flechas, teclado (← →) y swipe en móvil.
 * - Las imágenes horizontales van a sangre ("full"); las verticales/cuadradas
 *   en composición dividida ("split") para no recortar la arquitectura.
 * - Solo se cargan la diapositiva activa y la siguiente (las demás están en display:none).
 * - Cada proyecto tiñe la interfaz con los tonos de su imagen y muestra su paleta.
 * - Mientras carga se ve el color promedio + una miniatura borrosa (LQIP).
 */
import path from 'node:path';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { getImageTones } from '../lib/imageTones';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const AUTOPLAY_MS = 12000;

const proyectos = (await getCollection('proyectos', ({ data }) => data.publicado)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const total = proyectos.length;
const pad = (n: number) => String(n).padStart(2, '0');

// Tonos de cada portada (se calculan una vez al compilar).
const tones = await Promise.all(
  proyectos.map((p) => {
    const fsPath =
      (p.data.portada as { fsPath?: string }).fsPath ??
      (p.filePath ? path.resolve(path.dirname(p.filePath), 'img', `${p.id}.jpg`) : undefined);
    return getImageTones(fsPath);
  }),
);
---

<section
  class="album relative h-[calc(100svh-4rem)] min-h-[34rem] overflow-hidden bg-carbon md:h-[calc(100svh-5rem)]"
  aria-roledescription="carousel"
  aria-label={t('album.label')}
  data-album
  data-autoplay={AUTOPLAY_MS}
  style={`--album-duration: ${AUTOPLAY_MS}ms`}
>
  {
    proyectos.map((p, i) => {
      const d = p.data;
      const text = d[lang];
      const tone = tones[i];
      const layout = d.portada.width / d.portada.height >= 1.25 ? 'full' : 'split';
      const meta = [t(`cat.${d.categoria}`), t(`vista.${d.vista}`), d.ubicacion, d.anio].filter(Boolean).join(' · ');
      const toneVars = tone
        ? [
            `--tone-bg: ${tone.average}`,
            `--tone-dark: ${tone.dark.map(Math.round).join(' ')}`,
            `--tone-light: rgb(${tone.light.map(Math.round).join(' ')})`,
            `--tone-accent: ${tone.accent}`,
          ].join('; ')
        : undefined;
      return (
        <article
          class="slide"
          data-layout={layout}
          data-state={i === 0 ? 'active' : i === 1 ? 'next' : 'idle'}
          aria-roledescription="slide"
          aria-label={`${pad(i + 1)} ${t('album.slide')} ${pad(total)}: ${text.titulo}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          inert={i !== 0}
          style={toneVars}
        >
          <div class="slide-media">
            {tone && <div class="slide-lqip" style={`background-image: url(${tone.placeholder})`} />}
            <Picture
              src={d.portada}
              alt={text.descripcion}
              formats={['avif', 'webp']}
              widths={layout === 'full' ? [640, 1024, 1600, 2400, 3200] : [640, 960, 1400, 2000]}
              sizes={layout === 'full' ? '100vw' : '(min-width: 768px) 58vw, 100vw'}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              class="slide-img"
              style={`object-position: ${d.encuadre}`}
            />
            <div class="slide-shade" />
          </div>

          <div class="slide-text">
            <p class="label hidden opacity-70 md:block">{pad(i + 1)} / {pad(total)}</p>
            <h2 class="mt-5 text-4xl leading-[1.05] font-light tracking-[-0.03em] md:text-6xl lg:text-7xl">
              {text.titulo}
            </h2>
            <span class="slide-rule" />
            <p class="label opacity-80">{meta}</p>
            <p class="mt-4 max-w-md text-[0.95rem] leading-relaxed opacity-85 md:text-base">{text.descripcion}</p>
            {
              tone && (
                <ul class="slide-palette" aria-label={t('album.palette')}>
                  {tone.palette.map((c) => (
                    <li>
                      <span class="swatch" style={`background: ${c}`} />
                      <span class="swatch-hex">{c.toUpperCase()}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </article>
      );
    })
  }



  <!-- Controles -->
  <div class="album-controls">
    <p class="label tabular-nums md:hidden" aria-hidden="true">
      <span data-album-current>01</span> / {pad(total)}
    </p>
    <div class="flex items-center gap-1">
      <button type="button" class="album-btn" data-album-toggle aria-label={t('album.pause')}
        data-label-pause={t('album.pause')} data-label-play={t('album.play')}>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
      </button>
      <button type="button" class="album-btn" data-album-prev aria-label={t('album.prev')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
      </button>
      <button type="button" class="album-btn" data-album-next aria-label={t('album.next')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
    </div>
  </div>

  <div class="album-progress" aria-hidden="true"><span data-album-progress></span></div>
  <p class="sr-only" aria-live="polite" data-album-live></p>
</section>

<style>
  /* ---------- Diapositivas ---------- */
  .slide {
    position: absolute;
    inset: 0;
    display: none;
    opacity: 0;
    visibility: hidden;
  }
  .slide[data-state='next'] {
    display: block;
  }
  .slide[data-state='leaving'] {
    display: block;
    visibility: visible;
    opacity: 1;
    z-index: 1;
  }
  .slide[data-state='active'] {
    display: block;
    visibility: visible;
    opacity: 1;
    z-index: 2;
    transition: opacity 1.2s var(--ease-soft);
  }

  .slide {
    /* Sombra del texto: el tono oscuro de la imagen, mezclado con carbón para asegurar contraste. */
    --shade: color-mix(in oklab, rgb(var(--tone-dark, 32 33 31)) 45%, var(--color-carbon));
  }

  .slide-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Mientras carga: color promedio de la imagen en lugar de negro. */
    background: var(--tone-bg, var(--color-carbon));
  }
  .slide-lqip {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(24px);
    transform: scale(1.15);
  }
  .slide-media :global(picture),
  .slide-img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .slide-img {
    object-fit: cover;
    transform: scale(1.06);
    transition:
      opacity 0.9s var(--ease-soft),
      transform calc(var(--album-duration) + 1.5s) linear;
  }
  /* Solo con JS activo: la imagen aparece suave al terminar de cargar. */
  [data-js] .slide-img:not([data-loaded]) {
    opacity: 0;
  }
  .slide[data-state='active'] .slide-img,
  .slide[data-state='leaving'] .slide-img {
    transform: scale(1);
  }
  .slide-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--shade) 88%, transparent),
      color-mix(in oklab, var(--shade) 45%, transparent) 45%,
      transparent 75%
    );
  }
  @media (min-width: 768px) {
    .slide-shade {
      background: linear-gradient(
        to top,
        color-mix(in oklab, var(--shade) 82%, transparent),
        color-mix(in oklab, var(--shade) 30%, transparent) 45%,
        transparent 72%
      );
    }
  }

  .slide-text {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0 clamp(1rem, 4vw, 3rem) 6.5rem;
    color: var(--color-marfil);
  }
  .slide-text > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s var(--ease-soft),
      transform 0.9s var(--ease-soft);
  }
  .slide[data-state='active'] .slide-text > * {
    opacity: 1;
    transform: none;
  }
  .slide[data-state='active'] .slide-text > :nth-child(1) { transition-delay: 0.35s; }
  .slide[data-state='active'] .slide-text > :nth-child(2) { transition-delay: 0.45s; }
  .slide[data-state='active'] .slide-text > :nth-child(3) { transition-delay: 0.55s; }
  .slide[data-state='active'] .slide-text > :nth-child(4) { transition-delay: 0.6s; }
  .slide[data-state='active'] .slide-text > :nth-child(5) { transition-delay: 0.7s; }
  .slide[data-state='active'] .slide-text > :nth-child(6) { transition-delay: 0.85s; }

  .slide-rule {
    display: block;
    width: 3rem;
    height: 1px;
    margin: 1.5rem 0 1.25rem;
    background: currentColor;
  }

  /* Paleta del proyecto (como en la hoja de marca) */
  .slide-palette {
    display: none;
  }
  @media (min-width: 768px) {
    .slide-palette {
      display: flex;
      gap: 0.375rem;
      margin-top: 1.75rem;
    }
  }
  .slide-palette li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .swatch {
    display: block;
    width: 2.75rem;
    height: 1.75rem;
    box-shadow: inset 0 0 0 1px rgb(32 33 31 / 0.1);
  }
  /* Sobre imagen oscura, borde claro para que el tono más oscuro no se pierda. */
  .slide[data-layout='full'] .swatch {
    box-shadow: inset 0 0 0 1px rgb(243 240 233 / 0.28);
  }
  .swatch-hex {
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  /* Composición dividida en escritorio: texto sobre marfil, imagen a la derecha */
  @media (min-width: 768px) {
    .slide-text {
      padding-bottom: 4.5rem;
      max-width: 60rem;
    }
    .slide[data-layout='split'] .slide-media {
      left: 42%;
    }
    .slide[data-layout='split'] .slide-text {
      top: 0;
      right: 58%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      /* Marfil teñido con el tono claro de la imagen. */
      background: color-mix(in oklab, var(--color-marfil) 78%, var(--tone-light, var(--color-marfil)));
      color: var(--color-carbon);
    }
    .slide[data-layout='split'] .slide-rule {
      height: 2px;
      background: var(--tone-accent, currentColor);
    }
  }

  /* ---------- Controles ---------- */
  .album-controls {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(1rem, 4vw, 3rem);
    color: var(--color-marfil);
  }
  @media (min-width: 768px) {
    .album-controls {
      left: auto;
      bottom: 2.5rem;
      gap: 1.5rem;
    }
  }
  .album-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    transition: background-color 0.3s;
  }
  .album-btn:hover {
    background: rgb(243 240 233 / 0.15);
  }
  .album-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .album-btn .icon-play {
    fill: currentColor;
    stroke: none;
    width: 1rem;
  }
  .album-btn .icon-play,
  [data-paused] .album-btn .icon-pause {
    display: none;
  }
  [data-paused] .album-btn .icon-play {
    display: block;
  }

  .album-progress {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: rgb(243 240 233 / 0.2);
  }
  .album-progress span {
    display: block;
    height: 100%;
    background: var(--color-marfil);
    transform-origin: left;
    transform: scaleX(0);
  }
  .album-progress span.run {
    animation: album-progress var(--album-duration) linear forwards;
  }
  [data-paused] .album-progress span.run {
    animation-play-state: paused;
  }
  @keyframes album-progress {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  function initAlbum(root: HTMLElement) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const current = root.querySelector<HTMLElement>('[data-album-current]')!;
    const progress = root.querySelector<HTMLElement>('[data-album-progress]')!;
    const live = root.querySelector<HTMLElement>('[data-album-live]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-album-toggle]')!;
    const n = slides.length;

    // Aparición suave de cada imagen al terminar de cargar (sin JS se ven normal).
    root.toggleAttribute('data-js', true);
    root.querySelectorAll<HTMLImageElement>('.slide-img').forEach((img) => {
      const done = () => img.toggleAttribute('data-loaded', true);
      if (img.complete && img.naturalWidth) done();
      else img.addEventListener('load', done, { once: true });
    });

    // Con 0 o 1 proyectos no hay nada que rotar: se ocultan los controles.
    if (n < 2) {
      root.querySelectorAll<HTMLElement>('.album-controls, .album-progress').forEach((el) => (el.hidden = true));
      return;
    }
    let index = 0;
    let leavingTimer: number | undefined;

    const set = (el: HTMLElement, state: string) => {
      el.dataset.state = state;
      const visible = state === 'active';
      el.inert = !visible;
      if (visible) el.removeAttribute('aria-hidden');
      else el.setAttribute('aria-hidden', 'true');
    };

    const restartProgress = () => {
      progress.classList.remove('run');
      void progress.offsetWidth; // reinicia la animación
      progress.classList.add('run');
    };

    function go(to: number, announce = false) {
      const next = (to + n) % n;
      if (next === index) return;
      const prev = slides[index];
      const incoming = slides[next];

      clearTimeout(leavingTimer);
      slides.forEach((s) => s !== prev && s !== incoming && set(s, 'idle'));

      // Asegura que la entrante esté renderizada (opacity 0) antes de animar.
      set(incoming, 'next');
      void incoming.offsetWidth;
      set(prev, 'leaving');
      set(incoming, 'active');

      index = next;
      leavingTimer = window.setTimeout(() => {
        set(prev, 'idle');
        set(slides[(index + 1) % n], 'next'); // precarga la siguiente
      }, 1300);

      current.textContent = String(index + 1).padStart(2, '0');
      if (announce) live.textContent = incoming.getAttribute('aria-label') ?? '';
      restartProgress();
    }

    const setPaused = (paused: boolean) => {
      root.toggleAttribute('data-paused', paused);
      toggle.setAttribute('aria-label', paused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!);
    };

    progress.addEventListener('animationend', () => go(index + 1));
    toggle.addEventListener('click', () => setPaused(!root.hasAttribute('data-paused')));
    root.querySelector('[data-album-prev]')!.addEventListener('click', () => go(index - 1, true));
    root.querySelector('[data-album-next]')!.addEventListener('click', () => go(index + 1, true));

    // Teclado
    const onKey = (e: KeyboardEvent) => {
      if ((e.target as HTMLElement).closest('input, textarea, select')) return;
      if (e.key === 'ArrowRight') go(index + 1, true);
      if (e.key === 'ArrowLeft') go(index - 1, true);
    };
    document.addEventListener('keydown', onKey);

    // Swipe (táctil o arrastrando con el mouse).
    let startX = 0;
    let startY = 0;
    root.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    root.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) go(index + (dx < 0 ? 1 : -1), true);
    });

    // Pausa mientras la pestaña está oculta; sin autoplay si el usuario prefiere menos movimiento.
    const onVisibility = () => progress.style.animationPlayState = document.hidden ? 'paused' : '';
    document.addEventListener('visibilitychange', onVisibility);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPaused(true);

    restartProgress();

    // Limpieza al salir de la página (View Transitions).
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('visibilitychange', onVisibility);
        clearTimeout(leavingTimer);
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-album]').forEach(initAlbum);
  });
</script>
