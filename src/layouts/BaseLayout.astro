---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, path, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} — Rizk` : `Rizk — ${t('site.tagline')}`;
const desc = description ?? t('site.description');
const canonical = new URL(path(route, lang), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(path(route, code), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(path(route, 'es'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F3F0E9" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />

    <ClientRouter />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="label sr-only z-[60] bg-carbon px-4 py-3 text-marfil focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} current={route} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} current={route} />
  </body>
</html>
